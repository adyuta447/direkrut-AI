PORT=8080
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://direkrut:direkrut@localhost:5432/direkrut_ai?sslmode=disable
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

AI_ENGINE_BASE_URL=http://localhost:8000
# Harus sama persis dengan INTERNAL_API_KEY di apps/ai-engine/.env --
# dikirim lewat header X-Internal-Api-Key begitu client api-go->ai-engine
# dibangun (belum ada di pass ini, cuma didokumentasikan di sini dulu).
INTERNAL_API_KEY=

RESEND_API_KEY=
EMAIL_FROM_ADDRESS=notifikasi@direkrut.ai

XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=direkrut-ai-cv
# true buat MinIO (di sini) / S3-compatible custom lain; kosongkan/false
# begitu OBJECT_STORAGE_ENDPOINT nunjuk ke AWS S3 asli -- path-style ditolak
# 403 sama S3 asli.
OBJECT_STORAGE_USE_PATH_STYLE=true
